{
  "name": "dsh-mission-control",
  "version": "1.1.0",
  "private": true,
  "description": "Mission Control: a DeepSeek Harness sidebar dashboard of every session, built from the official session registry and event log",
  "keywords": [
    "deepseek-harness",
    "cordis-plugin",
    "dashboard",
    "sessions",
    "observability"
  ],
  "license": "MIT",
  "author": "Alejavi Rivera",
  "homepage": "https://github.com/luciomerlo/dsh-mission-control",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luciomerlo/dsh-mission-control.git"
  },
  "bugs": {
    "url": "https://github.com/luciomerlo/dsh-mission-control/issues"
  },
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "projection-fold.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.0"
  }
}
